DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_db?schema=public"
NODE_ENV=development
PORT=3000

# Solo true en desarrollo: sincroniza el esquema de TypeORM con las entidades.
# En producción usa SOLO migraciones (npm run migration:run).
DB_SYNCHRONIZE=false

# Secreto JWT. Obligatorio cuando NODE_ENV=production.
JWT_SECRET="cambiar-por-un-secreto-largo-y-unico"

# Origen permitido para CORS (URL exacta del frontend).
FRONTEND_URL="http://localhost:5173"