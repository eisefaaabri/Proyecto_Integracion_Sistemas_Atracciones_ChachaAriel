DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_db?schema=public"
NODE_ENV=development
PORT=3000

# Solo true en desarrollo: sincroniza el esquema de TypeORM con las entidades.
# En producción usa SOLO migraciones (npm run migration:run).
DB_SYNCHRONIZE=false

# Secreto JWT. Obligatorio cuando NODE_ENV=production.
JWT_SECRET="cambiar-por-un-secreto-largo-y-unico"

# CORS: URL exacta del frontend y orígenes adicionales separados por coma
# (ej. el dominio de Vercel). En desarrollo también se aceptan localhost y la
# IP de Tailscale; en producción, solo estos.
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS=
# Integración con Booking Prototipo
HOST=0.0.0.0
PARTNER_SERVICE_ID=NODE_ATR_ARIEL
# Clave M2M que Booking envía en X-API-Key. Sin definir: abierto en desarrollo, rechazado en producción.
BOOKING_API_KEY=
# Firma del voucher QR (si falta se usa JWT_SECRET).
VOUCHER_SECRET=

# Stock hacia Booking. REST (recomendado en Azure) o gRPC (Tailscale, :50051).
# Si no se fija BOOKING_STOCK_TRANSPORT, se usa REST cuando hay URL y si no gRPC.
# Sin URL ni host, no se envía stock.
BOOKING_STOCK_TRANSPORT=
BOOKING_HUB_REST_URL=
# Clave x-api-key hacia Booking; vacía = la misma BOOKING_API_KEY (clave compartida)
BOOKING_STOCK_API_KEY=
BOOKING_HUB_GRPC_HOST=
BOOKING_HUB_GRPC_PORT=50051
BOOKING_HUB_GRPC_TLS=false
# Días hacia adelante que se sincronizan al arrancar o al editar una atracción (0 = no)
BOOKING_GRPC_SYNC_DIAS=7
